# WhatsApp AI Automation — server environment TEMPLATE
#
# THIS FILE IS COMMITTED. It must never contain a real secret.
# Copy it to server/.env and put the real values there — server/.env is
# gitignored, this file is not.
#
#   cp server/.env.example server/.env

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database (required) ---------------------------------------------
# Supabase connection string, URI format.
#
# Use the SESSION pooler or the DIRECT connection. Do NOT use the
# TRANSACTION pooler (usually port 6543) — it does not support prepared
# statements or some DDL, and migrations fail in confusing ways there.
# `npm run doctor` warns you if it sees port 6543.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- Auth (required) --------------------------------------------------
# The service-role key BYPASSES row-level security. It must never be sent
# to the browser or committed. The client uses the anon key instead.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Tests ------------------------------------------------------------
# The tenant-isolation suite refuses to run without this. It is a separate
# variable rather than reusing DATABASE_URL on purpose: setting it is an
# explicit statement that you are willing to have rows written and deleted
# in that database. A test suite must never quietly inherit a connection
# string that might be pointing at production.
#
# SPLIT, AS OF 2026-08-29. The earlier note here said to set this to the same
# value as DATABASE_URL ("ONE PROJECT FOR NOW", decided 2026-08-08) and to
# split it before the first real pharmacy was onboarded. The pharmacy arrived;
# the values did not get split, and the suite spent that period pointed at a
# database with live customers, orders and a connected WhatsApp socket.
#
# That is now refused rather than documented against. Setting this to the same
# database as DATABASE_URL makes every database suite throw before it opens a
# connection — see server/tests/helpers/testDb.js. Changing the port or the
# pooler mode is not a separation and does not get past it.
#
# THREE VALID VALUES
#   empty            the database suites skip and say so; unit tests still run
#   a second Supabase project    works as-is — it already has an auth schema
#   any other Postgres           same command — the auth shim is applied
#                                automatically when it is missing
#
# Either way, once the value is set:
#   npm run migrate:test
#
# The suite only ever deletes rows it created, and 11 of its files sweep up
# leftovers from a previously failed run by tag ('isotest' and friends). The
# other 23 rely on their after() hook running, so a hard-killed run can leave
# rows behind — one more reason this must not be a database anyone relies on.
TEST_DATABASE_URL=

# --- Session credential encryption (required) -------------------------
# AES-256-GCM master key for WhatsApp session credentials. 32 bytes, as 64
# hex chars or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# CHANGING THIS ORPHANS EVERY CONNECTED SESSION — every pharmacy would have
# to re-pair. Back it up somewhere other than this file.
SESSION_ENCRYPTION_KEY=

# --- WhatsApp channel -------------------------------------------------
# 'baileys' (decided 2026-08-09, see ARCHITECTURE.md §6.1) needs no provider
# credentials at all — it authenticates as the pharmacy's own device.
CHANNEL_PROVIDER=baileys

# Optional but recommended before production. Datacenter IP ranges are a
# reported ban signal. Note that TWO agents get built from this: one for the
# socket, one for media transfers. Setting a proxy that covers only the
# socket still leaks the host IP on every image.
BAILEYS_PROXY_URL=

# Human-like reply latency. A safety control, not a UX preference —
# instant replies at all hours are a machine signature.
BAILEYS_MIN_REPLY_DELAY_MS=1000
BAILEYS_MAX_REPLY_DELAY_MS=3000

# --- Twilio (unused while CHANNEL_PROVIDER=baileys) -------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must exactly match the public URL the provider is configured to POST to,
# including scheme and any proxy path. A mismatch silently fails every
# webhook signature check with no other symptom.
TWILIO_WEBHOOK_URL=https://your-domain.com/webhooks/whatsapp

# --- AI ---------------------------------------------------------------
# Unset = the assistant reports itself unavailable and every conversation
# routes to a human. That is the correct degraded behaviour, not an outage.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000

# --- Background worker ------------------------------------------------
# Runs in-process in MVP. Set false on any additional web instance so only
# one process claims jobs.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=2

# Supabase session pooler caps total clients (15 on the free tier). This is
# ONE process's share — leave room for migrations, psql and a second
# instance, or they fail with EMAXCONNSESSION.
PG_POOL_MAX=4
