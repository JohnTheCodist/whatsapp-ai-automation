# WhatsApp AI Automation — server environment TEMPLATE
#
# THIS FILE IS COMMITTED. It must never contain a real secret.
# Copy it to server/.env and put the real values there — server/.env is
# gitignored, this file is not.
#
#   cp server/.env.example server/.env

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database (required) ---------------------------------------------
# Supabase connection string, URI format.
#
# Use the SESSION pooler or the DIRECT connection. Do NOT use the
# TRANSACTION pooler (usually port 6543) — it does not support prepared
# statements or some DDL, and migrations fail in confusing ways there.
# `npm run doctor` warns you if it sees port 6543.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Auth (required) --------------------------------------------------
# The service-role key BYPASSES row-level security. It must never be sent
# to the browser or committed. The client uses the anon key instead.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Tests ------------------------------------------------------------
# The tenant-isolation suite refuses to run without this. It is a separate
# variable rather than reusing DATABASE_URL on purpose: setting it is an
# explicit statement that you are willing to have rows written and deleted
# in that database. A test suite must never quietly inherit a connection
# string that might be pointing at production.
#
# ONE PROJECT FOR NOW (decided 2026-08-08): set this to the same value as
# DATABASE_URL above. Split it out before the first real pharmacy is
# onboarded, and never point it at a database holding real customers.
#
# The suite only ever deletes rows it created, and sweeps up leftovers
# from a previously failed run by their 'isotest' tag.
TEST_DATABASE_URL=

# --- WhatsApp channel -------------------------------------------------
CHANNEL_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must exactly match the public URL the provider is configured to POST to,
# including scheme and any proxy path. A mismatch silently fails every
# webhook signature check with no other symptom.
TWILIO_WEBHOOK_URL=https://your-domain.com/webhooks/whatsapp

# --- AI ---------------------------------------------------------------
# Unset = the assistant reports itself unavailable and every conversation
# routes to a human. That is the correct degraded behaviour, not an outage.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000

# --- Background worker ------------------------------------------------
# Runs in-process in MVP. Set false on any additional web instance so only
# one process claims jobs.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=2

PG_POOL_MAX=10
