node_modules/
dist/
build/

# Secrets — service-role keys and provider tokens live here.
.env
.env.*
!.env.example
server/.env

*.log
npm-debug.log*
tmp/
.DS_Store
Thumbs.db
.vscode/
.idea/
coverage/

# Dev supervisor output — crash evidence, not source.
logs/

# Assembled locally to scp secrets to a server, then deleted. Ignored so a
# copy left behind after a deploy cannot be committed by a later .
env.production*
*.env.production

# Clinical reference PDFs kept locally for writing the protocols.
# They are cited in evidence_references by name (a "locator" string) and are
# never opened as files at runtime, so the server does not need them — and at
# ~32MB they do not belong in git. A stray `git add -A server/` swept them in
# once; this stops the next one.
server/*.pdf

# Build artifact, uploaded to the server by hand — see server/index.js
# download route. 80MB has no business in git history.
/downloads/
