# Caddy — TLS and reverse proxy for app.rxnaija.com
#
# Install:  sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#           sudo systemctl reload caddy
#
# WHY CADDY AND NOT NGINX
# Certificates. Caddy obtains and renews Let's Encrypt automatically from the
# domain name alone — no certbot, no cron job, no renewal that silently
# expires eighteen months from now on a box nobody has logged into since.
# For a single-service deploy that is the whole difference.

# HTTP/3 IS OFF, DELIBERATELY.
#
# Caddy turns HTTP/3 on by default and advertises it as
# `Alt-Svc: h3=":443"; ma=2592000` — which the browser caches for thirty
# days and then PREFERS over TCP on every later visit.
#
# 2026-09-05: the dashboard would not open. The 606 KB JavaScript bundle
# aborted mid-transfer with ERR_QUIC_PROTOCOL_ERROR, and since that bundle
# IS the single-page app, the whole dashboard died with it. Nothing was
# wrong with the file. Measured 2026-09-06 over TCP, five consecutive
# requests: 606,385 bytes every time, byte-complete, 175 KB on the wire
# after gzip. The bytes are fine. The QUIC path is not.
#
# QUIC is UDP, and UDP is where a hostile network shows up. Two things
# break it here, neither visible from inside the application:
#
#   1. Linux ships net.core.rmem_max at ~208 KB. quic-go wants ~7 MB, logs
#      "failed to sufficiently increase receive buffer size" once at
#      startup, and then quietly drops packets under load. A single 606 KB
#      asset is exactly the size that turns that into a failed transfer
#      rather than a slow one.
#   2. Mobile networks and middleboxes throttle, rate-limit or plainly drop
#      sustained UDP/443. Nothing on this box can fix that one.
#
# TCP has neither problem, and HTTP/2 costs this app nothing measurable —
# it is one bundle and a handful of JSON calls, not a thousand-request
# waterfall. Working on every network a Nigerian pharmacy is actually on
# beats a handshake saving. That trade is not close.
#
# Browsers that already cached the Alt-Svc will still try h3 first. They
# now get no UDP answer at all, which fails instantly and falls back to
# TCP, instead of dying half way through a download. That is the fix
# arriving even before the cache expires.
#
# No golden test pins this, unlike health_uri below. That one has a
# correct answer; this is a judgement about the networks these users are
# on. If you raise the receive buffer:
#
#     net.core.rmem_max=7500000
#     net.core.wmem_max=7500000
#
# and can show h3 completing reliably from a real Nigerian mobile
# connection, turning it back on is a legitimate call. Delete this block
# and say why — do not weaken it quietly.
{
	servers {
		protocols h1 h2
	}

	# ON-DEMAND CERTIFICATES, AND THE GATE IN FRONT OF THEM.
	#
	# Pharmacy websites live at <address>.rxnaija.com. A wildcard DNS record
	# points every name under the domain at this box, so Caddy cannot know
	# the hostnames in advance and issues each certificate on first request.
	#
	# That is also the danger. Without a gate, a stranger requesting
	# whatever.rxnaija.com makes us ask Let's Encrypt for a certificate, and
	# the weekly issuance limit is counted against the whole registered
	# domain — so a few dozen junk hostnames would exhaust the budget real
	# pharmacies need. `ask` is what stops that: Caddy calls the endpoint
	# and only proceeds on a 200.
	#
	# The call goes to localhost and does NOT pass through the site blocks
	# below, which is why they can safely 404 that path for everyone else.
	on_demand_tls {
		ask http://localhost:4000/api/internal/tls-ask
	}
}

app.rxnaija.com {
	# Everything is one upstream: the Node process serves both /api and the
	# built dashboard (see the static block in server/index.js). No separate
	# root or file_server here — routing already happens inside the app, and
	# duplicating it in the proxy is how the two drift apart.
	reverse_proxy localhost:4000 {
		# WebSocket upgrades pass through untouched by default in Caddy v2,
		# which the dashboard's live connections rely on.

		# Fail fast rather than hanging if the app is restarting mid-deploy.
		#
		# /api/live, NOT /api/health — and the difference is the whole point of
		# there being two endpoints. See the comment above the route in
		# server/index.js; this line disagreed with it until 2026-09-06.
		#
		# An ACTIVE health check is Caddy asking "should I send traffic here".
		# /api/health answers a different question: it pings Postgres and
		# returns 503 when the database is unreachable. With a single upstream,
		# a failed check marks it down and Caddy answers 502 for everything —
		# so a transient database blip took the ENTIRE dashboard offline, for
		# staff who were only trying to look at a queue, while the app itself
		# was perfectly capable of serving them.
		#
		# It also made the probe do real work every 30 seconds, forever.
		# Measured 2026-09-06 from an external client: /api/health ~0.97s and
		# /api/live ~0.84s. Both figures are dominated by network latency to
		# the host and neither is the interesting number — the DIFFERENCE is,
		# and it is about 120ms. That is the Supabase round trip to Paris.
		#
		# Caddy probes over localhost, so it does not pay that latency at all
		# and ~120ms is essentially the entire cost of a /api/health probe
		# versus roughly nothing for /api/live. Modest either way: the reason
		# to change this is the failure mode above, not the milliseconds.
		#
		# WhatsApp was never affected either way: Baileys dials outbound and
		# does not go through this proxy. The cost of getting this wrong was
		# the dashboard, not the messaging.
		#
		# GOLDEN-006 asserts this stays pointed at the dependency-free endpoint.
		health_uri /api/live
		health_interval 30s
		health_timeout 5s
	}

	# Caddy reaches /api/internal over localhost, never through this block.
	# Anything arriving here asking for it came from the internet, and the
	# answer it wants — whether a pharmacy address is published — is exactly
	# what the public 404 refuses to disclose.
	respond /api/internal/* 404

	encode gzip zstd

	header {
		# HSTS. Only safe because Caddy guarantees TLS on this host — do not
		# copy this to an origin that must also answer plain HTTP.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The server sets its own Cache-Control (no-cache on index.html,
		# immutable on hashed assets). Caddy must not override it or a deploy
		# leaves browsers on a stale page pointing at files that no longer
		# exist.
		-Server
	}

	log {
		output file /var/log/caddy/rxnaija.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# ---------------------------------------------------------------------
# Every pharmacy website: <address>.rxnaija.com
#
# Requires a wildcard A record  *.rxnaija.com -> this host. Existing names
# are unaffected: app has its own A record and www is a CNAME elsewhere,
# and an explicit record always beats a wildcard.
#
# The app decides what is real. addressFromHost() strips the base domain,
# rejects nested labels and refuses every RESERVED name — www, api, mail,
# and the phishing-shaped set (secure, login, verify) — so this block being
# a wildcard does not mean any hostname gets a page. It means any hostname
# gets ASKED about.
*.rxnaija.com {
	tls {
		# Gated by on_demand_tls.ask in the global block above. Removing that
		# gate while leaving this line turns the wildcard DNS record into a
		# way for anyone to burn our certificate quota.
		on_demand
	}

	respond /api/internal/* 404

	# No health_uri here on purpose. It is the same upstream as the block
	# above, which already probes it every 30 seconds; a second probe of one
	# process buys nothing and doubles the noise. If the app is down these
	# pages 502 either way.
	reverse_proxy localhost:4000

	encode gzip zstd

	header {
		# The PAGE sets its own Content-Security-Policy — script-src 'none',
		# which is what makes stored XSS unreachable on published sites. Caddy
		# must not add or override one here, or that guarantee moves out of
		# the code that reasons about it and into a proxy config.
		#
		# No includeSubDomains: a pharmacy address has no subdomains of its
		# own, and asserting otherwise about names we do not control is a
		# promise this file cannot keep.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output file /var/log/caddy/rxnaija-sites.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# The marketing pages are static and can share the box for free. Uncomment
# once DNS for the root domain points here.
#
